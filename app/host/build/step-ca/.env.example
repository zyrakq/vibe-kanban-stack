# Generated by stackbuilder from concatenated .env.example files
# Source files: base/.env.example, step-ca/.env.example, step-ca-trust/.env.example

COMPOSE_PROJECT_NAME=vibe-kanban-host

IMAGE=localhost/vibe-kanban-host:0.1.45

LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
LOG_COMPRESS=true

RUST_LOG=info
HOST=0.0.0.0
PORT=3000
PREVIEW_PROXY_PORT=3001

# Public URL of the remote group (group 1) and of the relay
VK_SHARED_API_BASE=https://vibe-kanban.example.com
VK_SHARED_RELAY_API_BASE=https://relay.example.com

TZ=UTC
VIRTUAL_PORT=3000
VIRTUAL_HOST=host.example.com

VIRTUAL_PROTO=http

LETSENCRYPT_HOST=host.example.com

LETSENCRYPT_EMAIL=admin@example.com
# Step CA trust (root CA is read from the external step-ca-data volume, certs/ subpath)
STEP_CA_ROOT_CA_SRC=/step-ca-root/root_ca.crt
STEP_CA_ROOT_CA_FILE=/etc/ssl/step-ca/root_ca.crt
STEP_CA_WAIT_TIMEOUT=60