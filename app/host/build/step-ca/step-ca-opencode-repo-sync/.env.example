COMPOSE_PROJECT_NAME=vibe-kanban-host

IMAGE=localhost/vibe-kanban-host:0.1.45

LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
LOG_COMPRESS=true

RUST_LOG=info
HOST=0.0.0.0
PORT=3000
PREVIEW_PROXY_PORT=3001

VK_SHARED_API_BASE=https://vibe-kanban.example.com
