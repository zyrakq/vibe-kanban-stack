VIRTUAL_PROTO=http

LETSENCRYPT_HOST=host.example.com

LETSENCRYPT_EMAIL=admin@example.com
STEP_CA_ROOT_CA_SRC=/step-ca-root/root_ca.crt
STEP_CA_ROOT_CA_FILE=/etc/ssl/step-ca/root_ca.crt
STEP_CA_WAIT_TIMEOUT=60
OPENCODE_IMAGE=localhost/vibe-kanban-host-opencode:0.1.45
OPENCODE_CONFIG_CONTENT=
# openssl rand -hex 32
ANTHROPIC_API_KEY=sk-ant-api03-example-key
# openssl rand -hex 32
OPENAI_API_KEY=sk-proj-example-key
# openssl rand -hex 32
OPENROUTER_API_KEY=sk-or-v1-example-key
# openssl rand -hex 32
GEMINI_API_KEY=AIzaSyExampleKey
