# Generated by stackbuilder from concatenated .env.example files
# Source files: base/.env.example, forwarding/.env.example, postgresql/.env.example

COMPOSE_PROJECT_NAME=vibe-kanban-remote

IMAGE=localhost/vibe-kanban-remote-server:0.1.45

LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
LOG_COMPRESS=true

RUST_LOG=info,remote=info
SERVER_LISTEN_ADDR=0.0.0.0:8081
ELECTRIC_URL=http://vibe-kanban-electric:3000

# openssl rand -base64 48
VIBEKANBAN_REMOTE_JWT_SECRET=example-jwt-secret
# openssl rand -base64 48
ELECTRIC_ROLE_PASSWORD=example-electric-password

SELF_HOST_LOCAL_AUTH_EMAIL=admin@example.com
# openssl rand -base64 48
SELF_HOST_LOCAL_AUTH_PASSWORD=example-login-password

TZ=UTC
VIBEKANBAN_PORT=8081
SERVER_PUBLIC_BASE_URL=http://localhost:8081
COMPOSE_EXTENDS=:docker-compose.db.yml
COMPOSE_FILE=docker-compose.yml${COMPOSE_EXTENDS:-}
POSTGRES_DB=remote
POSTGRES_USER=vibe-kanban
# openssl rand -base64 48
POSTGRES_PASSWORD=changeme

DB_PUBLISH_ADDR=127.0.0.1
DB_PUBLISH_PORT=5432