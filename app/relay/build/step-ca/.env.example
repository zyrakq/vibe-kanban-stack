# Generated by stackbuilder from concatenated .env.example files
# Source files: base/.env.example, step-ca/.env.example

COMPOSE_PROJECT_NAME=vibe-kanban-relay

IMAGE=localhost/vibe-kanban-relay:0.1.45

LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
LOG_COMPRESS=true

RUST_LOG=info
RELAY_LISTEN_ADDR=0.0.0.0:8082

# Must equal the remote group's secret (base64, >=32 bytes decoded)
VIBEKANBAN_REMOTE_JWT_SECRET=

# Remote group's Postgres (published port, see remote README)
REMOTE_DB_HOST=host.docker.internal
REMOTE_DB_PORT=5432
REMOTE_DB_NAME=remote
REMOTE_DB_USER=vibe-kanban
REMOTE_DB_PASSWORD=
REMOTE_DB_SSLMODE=prefer

TZ=UTC
VIRTUAL_PORT=8082
VIRTUAL_HOST=relay.example.com,*.relay.example.com

VIRTUAL_PROTO=http

# http-01 (step-ca) cannot issue wildcards: cert only for the apex relay host
LETSENCRYPT_HOST=relay.example.com

LETSENCRYPT_EMAIL=admin@example.com