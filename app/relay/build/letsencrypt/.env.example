# Generated by stackbuilder from concatenated .env.example files
# Source files: base/.env.example, letsencrypt/.env.example

COMPOSE_PROJECT_NAME=vibe-kanban-relay

IMAGE=localhost/vibe-kanban-relay:0.1.45

LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
LOG_COMPRESS=true

RUST_LOG=info
RELAY_LISTEN_ADDR=0.0.0.0:8082

# openssl rand -base64 48
VIBEKANBAN_REMOTE_JWT_SECRET=example-jwt-secret

REMOTE_DB_HOST=host.docker.internal
REMOTE_DB_PORT=5432
REMOTE_DB_NAME=remote
REMOTE_DB_USER=vibe-kanban
# openssl rand -base64 48
REMOTE_DB_PASSWORD=example-db-password
REMOTE_DB_SSLMODE=prefer

TZ=UTC
VIRTUAL_PORT=8082
VIRTUAL_HOST=relay.example.com,*.relay.example.com

VIRTUAL_PROTO=http

LETSENCRYPT_HOST=relay.example.com,*.relay.example.com

LETSENCRYPT_EMAIL=admin@example.com