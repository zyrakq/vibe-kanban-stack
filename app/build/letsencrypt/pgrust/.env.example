# Generated by stackbuilder from concatenated .env.example files
# Source files: base/.env.example, letsencrypt/.env.example, pgrust/.env.example

# === BASE CONFIGURATION ===
# Project name for Docker Compose
COMPOSE_PROJECT_NAME=vibe-kanban

# Prebuilt source-built image (build it first, see app/README.md)
IMAGE=localhost/vibe-kanban-remote-server:0.1.45

# Logging
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
LOG_COMPRESS=true

# Server runtime
RUST_LOG=info,remote=info
SERVER_LISTEN_ADDR=0.0.0.0:8081
ELECTRIC_URL=http://vibe-kanban-electric:3000

# === SECRETS (openssl rand -base64 48) — both required ===
VIBEKANBAN_REMOTE_JWT_SECRET=
ELECTRIC_ROLE_PASSWORD=

# === AUTH (configure at least one method) ===
# GitHub OAuth app: callback https://<domain>/v1/oauth/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Google OAuth: redirect https://<domain>/v1/oauth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Bootstrap local admin credential (single shared login)
SELF_HOST_LOCAL_AUTH_EMAIL=
SELF_HOST_LOCAL_AUTH_PASSWORD=

# Timezone
TZ=UTC
# === LETSENCRYPT CONFIGURATION ===
# Virtual host domain for nginx-proxy
VIRTUAL_PORT=8081
VIRTUAL_HOST=vibe-kanban.example.com

# Protocol nginx-proxy expects the app to speak
VIRTUAL_PROTO=http

# Let's Encrypt SSL certificate domain
LETSENCRYPT_HOST=vibe-kanban.example.com

# Email for Let's Encrypt certificate registration
LETSENCRYPT_EMAIL=admin@example.com
# Database (pgrust variant)
COMPOSE_EXTENDS=:docker-compose.db.yml
COMPOSE_FILE=docker-compose.yml${COMPOSE_EXTENDS:-}
POSTGRES_DB=vibe-kanban
POSTGRES_USER=vibe-kanban
POSTGRES_PASSWORD=changeme