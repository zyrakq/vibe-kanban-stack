# Generated by stackbuilder from concatenated .env.example files
# Source files: base/.env.example, forwarding/.env.example

# === BASE CONFIGURATION ===
# Project name for Docker Compose
COMPOSE_PROJECT_NAME=vibe-kanban

# Docker image
IMAGE=localhost/vibe-kanban

# Logging
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
LOG_COMPRESS=true

HOST=0.0.0.0
PORT=3000
# Forwarding
VK_ALLOWED_ORIGINS=http://localhost:3000